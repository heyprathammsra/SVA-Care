# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# APPS_SCRIPT_URL (Optional): Override the school's Google Apps Script Web App URL on the server.
# Never prefix this with VITE_ so it is never bundled into public client JavaScript.
APPS_SCRIPT_URL=""

# APPS_SCRIPT_SECRET (Recommended for online deployment):
# Shared secret matching API_SECRET in Code.gs so nobody can query your Google Sheet Web App directly.
APPS_SCRIPT_SECRET=""

# DATA_ENCRYPTION_KEY (Recommended for online deployment):
# Master secret (min 32 random characters) used for AES-256-GCM clinical field encryption and encrypted local storage.
# Keep a safe offline copy of this key — encrypted clinical records in Google Sheets require this key to decrypt.
DATA_ENCRYPTION_KEY=""

# EXCEL_EXPORT_PASSWORD (Optional):
# Password required to open downloaded Excel (.xlsx) infirmary spreadsheets. Defaults to SVA@Infirmary2026 if unset.
EXCEL_EXPORT_PASSWORD=""

